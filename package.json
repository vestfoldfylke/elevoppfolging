{
  "name": "elevoppfolging",
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run check && vite dev",
    "safe-post-install": "npm rebuild mongodb-client-encryption",
    "build": "vite build --mode build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:vite": "vitest --watch=false",
    "test": "tsc --noEmit && biome check && npm run check && npm run test:vite && npm run build",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@digdir/designsystemet-types": "^1.15.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/luxon": "^3.7.3",
    "@types/node": "^26.1.2",
    "happy-dom": "^20.11.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.18.0",
    "@digdir/designsystemet-web": "^1.18.0",
    "@navikt/fnrvalidator": "^2.2.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@vestfoldfylke/loglady": "^2.1.0",
    "@vestfoldfylke/vestfold-metrics": "^1.1.0",
    "luxon": "^3.7.2",
    "mongodb": "^7.5.0",
    "mongodb-client-encryption": "^7.2.1"
  }
}
