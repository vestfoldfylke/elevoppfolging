{
  "name": "elevoppfolging",
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run check && vite dev",
    "safe-post-install": "npm rebuild mongodb-client-encryption",
    "build": "vite build --mode build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:vite": "vitest --watch=false",
    "test": "tsc --noEmit && biome check && npm run check && npm run test:vite && npm run build",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@digdir/designsystemet-types": "^1.15.0",
    "@sveltejs/kit": "^2.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.9.2",
    "happy-dom": "^20.10.2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.15.0",
    "@digdir/designsystemet-web": "^1.15.0",
    "@navikt/fnrvalidator": "^2.2.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@vestfoldfylke/loglady": "^2.1.0",
    "@vestfoldfylke/vestfold-metrics": "^1.0.1",
    "luxon": "^3.7.2",
    "mongodb": "^7.2.0",
    "mongodb-client-encryption": "^7.0.0"
  }
}
